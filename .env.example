# ==============================================================================
# Research Orbit (ResearchPilot AI) - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure your local settings:
# cp .env.example .env

# Groq API Key (Required for Llama 3.3 70B inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (Defaults to local SQLite, PostgreSQL also supported)
DATABASE_URL=sqlite:///./research_pilot_v3.db

# Authentication Security (Generate a secure random string for production)
SECRET_KEY=your_super_secret_jwt_key_change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
